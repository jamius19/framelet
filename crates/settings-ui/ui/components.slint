import { Theme } from "theme.slint";

export component Icon inherits Text {
    font-family: Theme.icons;
    font-size: 16px;
    horizontal-alignment: center;
    vertical-alignment: center;
    color: Theme.text;
}

export component SectionLabel inherits Text {
    font-size: 14px;
    font-weight: 600;
    color: Theme.text;
}

// A Fluent "setting card": optional icon, title, description and a trailing control (`@children`).
export component SettingCard inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <string> glyph;
    // When set, replaces the description and is shown in the error colour.
    in property <string> error;

    background: Theme.card-bg;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.card-border;
    min-height: 56px;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 16px;

        if root.glyph != "": VerticalLayout {
            alignment: center;
            Icon {
                width: 24px;
                height: 24px;
                text: root.glyph;
                font-size: 18px;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                font-size: 14px;
                color: Theme.text;
                wrap: word-wrap;
            }
            if root.error == "" && root.description != "": Text {
                text: root.description;
                font-size: 12px;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }
            if root.error != "": Text {
                text: root.error;
                font-size: 12px;
                color: Theme.error;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            alignment: center;
            @children
        }
    }
}

// Like `SettingCard`, but the control (`@children`) sits on its own row below the text and
// fills the card width. Used for paths and other long values.
export component StackedCard inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <string> glyph;
    in property <string> error;

    background: Theme.card-bg;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.card-border;

    VerticalLayout {
        padding: 16px;
        padding-top: 12px;
        padding-bottom: 14px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 16px;
            VerticalLayout {
                alignment: center;
                Icon {
                    width: 24px;
                    height: 24px;
                    text: root.glyph;
                    font-size: 18px;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                Text {
                    text: root.title;
                    font-size: 14px;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                Text {
                    text: root.error != "" ? root.error : root.description;
                    font-size: 12px;
                    color: root.error != "" ? Theme.error : Theme.text-secondary;
                    wrap: word-wrap;
                }
            }
        }
        HorizontalLayout {
            padding-left: 40px;
            spacing: 8px;
            @children
        }
    }
}

// Informational / warning banner.
export component InfoBar inherits Rectangle {
    in property <string> text;
    in property <string> glyph: "\u{E946}";
    in property <bool> warning;

    background: root.warning ? Theme.warning-bg : Theme.card-bg;
    border-radius: 4px;
    border-width: 1px;
    border-color: root.warning ? Theme.warning-bg : Theme.card-border;

    HorizontalLayout {
        padding: 12px;
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        VerticalLayout {
            alignment: start;
            Icon {
                width: 20px;
                height: 20px;
                text: root.glyph;
                color: root.warning ? Theme.warning-text : Theme.accent;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            font-size: 14px;
            color: Theme.text;
            wrap: word-wrap;
            vertical-alignment: center;
        }
    }
}

export component FButton inherits Rectangle {
    in property <string> text;
    in property <string> glyph;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked();

    height: 32px;
    border-radius: 4px;
    border-width: 1px;
    background: !root.enabled ? Theme.control-disabled
        : root.primary ? (ta.pressed ? Theme.accent-pressed : ta.has-hover ? Theme.accent-hover : Theme.accent)
        : (ta.pressed ? Theme.control-pressed : ta.has-hover ? Theme.control-hover : Theme.control);
    border-color: root.primary && root.enabled ? Theme.accent-hover : Theme.control-border;

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        alignment: center;
        if root.glyph != "": Icon {
            text: root.glyph;
            font-size: 14px;
            color: root.primary ? Theme.on-accent : Theme.text;
        }
        Text {
            text: root.text;
            font-size: 14px;
            vertical-alignment: center;
            color: !root.enabled ? Theme.text-disabled : root.primary ? Theme.on-accent : Theme.text;
        }
    }
}

export component FToggle inherits Rectangle {
    in-out property <bool> checked;
    callback toggled(bool);

    width: 84px;
    height: 32px;

    fs := FocusScope {
        key-pressed(e) => {
            if e.text == " " || e.text == "\n" {
                root.checked = !root.checked;
                root.toggled(root.checked);
                return accept;
            }
            reject
        }
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            fs.focus();
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
    Text {
        x: 0;
        width: 32px;
        text: root.checked ? "On" : "Off";
        font-size: 14px;
        color: Theme.text;
        vertical-alignment: center;
        horizontal-alignment: right;
    }
    Rectangle {
        x: 44px;
        y: (parent.height - 20px) / 2;
        width: 40px;
        height: 20px;
        border-radius: 10px;
        background: root.checked
            ? (ta.pressed ? Theme.accent-pressed : ta.has-hover ? Theme.accent-hover : Theme.accent)
            : (ta.has-hover ? Theme.control-hover : transparent);
        border-width: 1px;
        border-color: root.checked ? Theme.accent : Theme.control-border-strong;

        Rectangle {
            property <length> size: ta.has-hover || ta.pressed ? 14px : 12px;
            x: root.checked ? parent.width - self.width - 5px : 3px;
            y: (parent.height - self.height) / 2 - 1px;
            width: self.size;
            height: self.size;
            border-radius: self.size / 2;
            background: root.checked ? Theme.on-accent : Theme.text-secondary;
            animate x { duration: 90ms; easing: ease-out; }
            animate width { duration: 90ms; }
            animate height { duration: 90ms; }
        }
    }
    if fs.has-focus: Rectangle {
        x: 40px;
        y: (parent.height - 28px) / 2;
        width: 48px;
        height: 28px;
        border-radius: 14px;
        border-width: 2px;
        border-color: Theme.text;
    }
}

export component FTextField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <bool> invalid;
    callback edited(string);
    callback committed();

    height: 32px;
    min-width: 80px;
    border-radius: 4px;
    clip: true;
    background: input.has-focus ? (Theme.dark ? #1f1f1f : #ffffff) : ta.has-hover ? Theme.control-hover : Theme.control;
    border-width: 1px;
    border-color: root.invalid ? Theme.error : Theme.control-border;

    ta := TouchArea {
        mouse-cursor: MouseCursor.text;
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        VerticalLayout {
            alignment: center;
            input := TextInput {
                font-size: 14px;
                color: Theme.text;
                single-line: true;
                wrap: no-wrap;
                selection-background-color: Theme.accent;
                selection-foreground-color: Theme.on-accent;
                edited => {
                    root.edited(self.text);
                }
                accepted => {
                    root.committed();
                }
                changed has-focus => {
                    if !self.has-focus {
                        root.committed();
                    }
                }
            }
        }
    }
    if input.text == "" && root.placeholder != "": Text {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.placeholder;
        font-size: 14px;
        color: Theme.text-tertiary;
        vertical-alignment: center;
        overflow: elide;
    }
    // 2 px focus / error underline.
    Rectangle {
        y: parent.height - self.height;
        height: input.has-focus || root.invalid ? 2px : 0px;
        background: root.invalid ? Theme.error : Theme.accent;
    }
}

export component FComboBox inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index;
    in property <bool> enabled: true;
    in property <length> box-width: 190px;
    callback selected(int);

    property <length> item-height: 36px;
    property <length> list-height: root.model.length * root.item-height + 8px;
    property <bool> open-up: root.absolute-position.y + root.height + root.list-height + 16px > Theme.window-height;

    width: root.box-width;
    height: 32px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.control-border;
    background: !root.enabled ? Theme.control-disabled
        : ta.pressed ? Theme.control-pressed : ta.has-hover ? Theme.control-hover : Theme.control;

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            popup.show();
        }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        Text {
            horizontal-stretch: 1;
            text: root.current-index >= 0 && root.current-index < root.model.length
                ? root.model[root.current-index] : "";
            font-size: 14px;
            vertical-alignment: center;
            overflow: elide;
            color: root.enabled ? Theme.text : Theme.text-disabled;
        }
        Icon {
            text: "\u{E70D}";
            font-size: 11px;
            color: root.enabled ? Theme.text-secondary : Theme.text-disabled;
        }
    }
    popup := PopupWindow {
        x: 0;
        y: root.open-up ? -root.list-height - 4px : root.height + 4px;
        width: root.width;
        height: root.list-height;
        close-policy: close-on-click-outside;

        Rectangle {
            background: Theme.flyout-bg;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.flyout-border;
            VerticalLayout {
                padding: 4px;
                spacing: 0px;
                for item[i] in root.model: Rectangle {
                    height: root.item-height;
                    border-radius: 4px;
                    background: row.pressed ? Theme.control-pressed
                        : row.has-hover ? Theme.nav-hover
                        : i == root.current-index ? Theme.nav-selected : transparent;
                    Rectangle {
                        x: 0;
                        y: (parent.height - self.height) / 2;
                        width: 3px;
                        height: 16px;
                        border-radius: 1.5px;
                        background: Theme.accent;
                        visible: i == root.current-index;
                    }
                    Text {
                        x: 12px;
                        width: parent.width - 24px;
                        text: item;
                        font-size: 14px;
                        color: Theme.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    row := TouchArea {
                        clicked => {
                            root.current-index = i;
                            root.selected(i);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

export component FSlider inherits Rectangle {
    in-out property <int> value;
    callback edited(int);

    property <length> thumb: 20px;
    property <length> span: root.width - root.thumb;

    height: 32px;
    min-width: 120px;

    function set-from(x: length) {
        root.value = max(0, min(100, round((x - root.thumb / 2) / root.span * 100)));
        root.edited(root.value);
    }

    Rectangle {
        x: root.thumb / 2;
        y: (parent.height - self.height) / 2;
        width: root.span;
        height: 4px;
        border-radius: 2px;
        background: Theme.dark ? #9a9a9a : #8a8a8a;
        Rectangle {
            x: 0;
            width: parent.width * root.value / 100;
            border-radius: 2px;
            background: Theme.accent;
        }
    }
    Rectangle {
        x: root.span * root.value / 100;
        y: (parent.height - self.height) / 2;
        width: root.thumb;
        height: root.thumb;
        border-radius: root.thumb / 2;
        background: Theme.dark ? #454545 : #ffffff;
        border-width: 1px;
        border-color: Theme.control-border;
        Rectangle {
            width: ta.pressed ? 10px : ta.has-hover ? 14px : 12px;
            height: self.width;
            x: (parent.width - self.width) / 2 - 1px;
            y: (parent.height - self.height) / 2 - 1px;
            border-radius: self.width / 2;
            background: ta.pressed ? Theme.accent-pressed : Theme.accent;
            animate width { duration: 90ms; }
        }
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.set-from(self.mouse-x);
            }
        }
        moved => {
            if self.pressed {
                root.set-from(self.mouse-x);
            }
        }
    }
}

// Card with a title/description on top and a full-width slider with end labels below.
export component SliderCard inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <string> low-label;
    in property <string> high-label;
    in-out property <int> value;
    callback edited(int);

    background: Theme.card-bg;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.card-border;

    VerticalLayout {
        padding: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 2px;
        Text {
            text: root.title;
            font-size: 14px;
            color: Theme.text;
        }
        Text {
            text: root.description;
            font-size: 12px;
            color: Theme.text-secondary;
            wrap: word-wrap;
        }
        HorizontalLayout {
            padding-top: 6px;
            spacing: 12px;
            Text {
                text: root.low-label;
                font-size: 12px;
                color: Theme.text-secondary;
                vertical-alignment: center;
            }
            FSlider {
                horizontal-stretch: 1;
                value <=> root.value;
                edited(v) => {
                    root.edited(v);
                }
            }
            Text {
                text: root.high-label;
                font-size: 12px;
                color: Theme.text-secondary;
                vertical-alignment: center;
            }
            Rectangle {
                width: 40px;
                Text {
                    text: root.value;
                    font-size: 14px;
                    font-weight: 600;
                    color: Theme.text;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// Shortcut box: key caps when idle, a prompt while capturing. Capture itself is done in Rust
// (it needs the real virtual-key codes); the box only starts it and cancels on focus loss.
export component HotkeyBox inherits Rectangle {
    in property <[string]> keys;
    in property <bool> capturing;
    in property <bool> invalid;
    callback start-capture();
    callback cancel-capture();

    height: 32px;
    min-width: 190px;
    border-radius: 4px;
    clip: true;
    border-width: 1px;
    border-color: root.capturing ? Theme.accent : Theme.control-border;
    background: root.capturing ? (Theme.dark ? #1f1f1f : #ffffff) : ta.has-hover ? Theme.control-hover : Theme.control;

    fs := FocusScope {
        changed has-focus => {
            if !self.has-focus && root.capturing {
                root.cancel-capture();
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            if !root.capturing {
                fs.focus();
                root.start-capture();
            }
        }
    }
    if root.capturing: Text {
        text: "Press a shortcut…";
        font-size: 14px;
        color: Theme.accent;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if !root.capturing: HorizontalLayout {
        alignment: center;
        padding: 5px;
        spacing: 4px;
        for key in root.keys: Rectangle {
            min-width: 24px;
            border-radius: 4px;
            background: Theme.chip;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                Text {
                    text: key;
                    font-size: 12px;
                    color: Theme.text;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }
    }
    Rectangle {
        y: parent.height - self.height;
        height: root.capturing || root.invalid ? 2px : 0px;
        background: root.invalid ? Theme.error : Theme.accent;
    }
}

// Scrollable page with a title and a thin draggable scroll bar.
export component Page inherits Rectangle {
    in property <string> title;

    fl := Flickable {
        content-width: self.width;
        content-height: max(lay.preferred-height + 48px, self.height);
        // Clicking empty space takes keyboard focus away from text fields and the hotkey box.
        focus-sink := FocusScope {
            width: 0px;
            height: 0px;
        }
        TouchArea {
            width: fl.content-width;
            height: fl.content-height;
            clicked => {
                focus-sink.focus();
            }
        }
        VerticalLayout {
            alignment: start;
            padding-left: 32px;
            padding-right: 32px;
            padding-top: 24px;
            padding-bottom: 24px;
            lay := VerticalLayout {
                spacing: 4px;
                Text {
                    text: root.title;
                    font-size: 28px;
                    font-weight: 600;
                    color: Theme.text;
                    height: 52px;
                    vertical-alignment: top;
                }
                @children
            }
        }
    }
    if fl.content-height > fl.height + 1px: Rectangle {
        x: parent.width - self.width;
        width: 14px;
        Rectangle {
            property <length> thumb-h: max(32px, parent.height * fl.height / fl.content-height);
            x: parent.width - self.width - 3px;
            y: (-fl.content-y) / (fl.content-height - fl.height) * (parent.height - self.height);
            width: bar.pressed || bar.has-hover ? 6px : 3px;
            height: self.thumb-h;
            border-radius: self.width / 2;
            background: Theme.text-tertiary;
        }
        bar := TouchArea {
            property <length> grab;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    self.grab = self.mouse-y - (-fl.content-y) / (fl.content-height - fl.height)
                        * (self.height - max(32px, self.height * fl.height / fl.content-height));
                }
            }
            moved => {
                if self.pressed {
                    let th = max(32px, self.height * fl.height / fl.content-height);
                    let ratio = (self.mouse-y - self.grab) / (self.height - th);
                    fl.content-y = -max(0, min(1, ratio)) * (fl.content-height - fl.height);
                }
            }
        }
    }
}
